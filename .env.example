# Copy to .env and fill in the values: cp .env.example .env
# The DB values below are MOCK values matching docker-compose.yml.

PORT=3000

# Master PostgreSQL database (holds the tenant_configs table).
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=mock_master_user
DB_PASSWORD=mock_master_password
DB_DATABASE=mock_master

# SSO token decryption. Get the real values from the SSO provider.
# aes-256-cbc needs a 32-character key and a 16-character IV.
SSO_ENCRYPTION_ALGORITHM=aes-256-cbc
SSO_ENCRYPTION_KEY=
SSO_IV=
